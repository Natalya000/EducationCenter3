<Window x:Class="EducationCenter3.View.Windows.CoordinatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EducationCenter3.View.Windows"
        mc:Ignorable="d"
        Title="Окно координатора" Height="900" Width="1600" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Поиск и фильтрация -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Поиск:"/>
            <TextBox Name="SearchByNameTb" Grid.Column="2"/>
            <TextBlock Grid.Column="4" Text="Фильтр:"/>
            <ComboBox Name="FilterByRoleCmb" Grid.Column="6"/>
            <Button Name="StartFiltersSearchBtn" Grid.Column="8" 
                    Content="Найти" Click="StartFiltersSearchBtn_Click"/>
        </Grid>

        <!-- Список, форма добавления/редактрирования -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width=".4*"/>
            </Grid.ColumnDefinitions>

            <!-- список-->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>
            

            <TextBlock Text="Записи отсутствуют" FontSize="40"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <ListView Name="UsersLv" SelectionChanged="UsersLv_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ФИО" 
                                        DisplayMemberBinding="{Binding Employee.FullName}"/>
                        <GridViewColumn Header="Логин" 
                                        DisplayMemberBinding="{Binding Login}"/>
                        <GridViewColumn Header="Роль" 
                                        DisplayMemberBinding="{Binding Role.Name}"/>
                        <GridViewColumn Header="Статус блокировки" 
                                        DisplayMemberBinding="{Binding Employee.IsActive}"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock Name="ItemCountTbl" Grid.Row="2" Text="Записей найдено: 0"/>
        </Grid>
        <!-- Форма добавления/редактирования-->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>
            
            <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="5"/>
                        <RowDefinition Height="50"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ФИО"/>
                    <TextBox Name="FullNameTb" Grid.Row="0" Grid.Column="2"
                             Text="{Binding Employee.FullName}"/>
                
                    <TextBlock Grid.Row="2" Text="Должность"/>
                    <ComboBox Name="PositionCmb" Grid.Row="2" Grid.Column="2"
                              SelectedItem="{Binding Employee.Position}"/>
                
                    <TextBlock Grid.Row="4" Text="Отдел"/>
                    <ComboBox Name="DepartmentCmb" Grid.Row="4" Grid.Column="2"
                              SelectedItem="{Binding Employee.Department}"/>
                
                    <TextBlock Grid.Row="6" Text="Почта"/>
                    <TextBox Name="EmailTb" Grid.Row="6" Grid.Column="2"
                             Text="{Binding Employee.Email}"/>
                
                    <TextBlock Grid.Row="8" Text="Телефон"/>
                    <TextBox Name="PhoneTb" Grid.Row="8" Grid.Column="2"
                             Text="{Binding Employee.Phone}"/>
                
                    <TextBlock Grid.Row="10" Text="Дата приёма"/>
                    <DatePicker Name="HireDateDp" Grid.Row="10" Grid.Column="2"
                                Text="{Binding Employee.HireDate}"/>
                
                    <CheckBox Grid.Row="12" Name="IsActiveCb" Grid.Column="2"
                              Content="Работает"
                              IsChecked="{Binding Employee.IsActive}"/>
                
                    <TextBlock Grid.Row="14" Text="Заметки"/>
                    <TextBox Name="NoteTb" Grid.Row="14" Grid.Column="2"
                             Text="{Binding Employee.Note}"/>
                
                    <TextBlock Grid.Row="16" Text="Логин"/>
                    <TextBox Name="LoginTb" Grid.Row="16" Grid.Column="2"
                             Text="{Binding Login}"/>
                
                    <TextBlock Grid.Row="18" Text="Пароль"/>
                    <TextBox Name="PasswordPb" Grid.Row="18" Grid.Column="2"
                                 Text="{Binding Password}"/>
                
                    <TextBlock Grid.Row="20" Text="Роль"/>
                    <ComboBox Name="RoleCmb" Grid.Row="20" Grid.Column="2"
                              SelectedItem="{Binding Role}"/>
                </Grid>
            
            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button Name="AddUserBtn" Content="Добавить" Margin="0 0 20 0" 
                        Click="AddUserBtn_Click"/>
                <Button Name="EditUserBtn" Content="Редактировать"
                        Click="EditUserBtn_Click"/>
                <Button Name="ClearBtn" Content="Очистить"
                        Click="ClearBtn_Click"/>
            </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
