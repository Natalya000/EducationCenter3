<Window x:Class="EducationCenter3.View.Windows.CoordinatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EducationCenter3.View.Windows"
        mc:Ignorable="d"
        Title="Окно координатора" Height="720" Width="1280" WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Поиск и фильтрация -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Поиск:"/>
            <TextBox Name="SearchByNameTb" Grid.Column="2"/>
            <TextBlock Grid.Column="4" Text="Фильтр:"/>
            <ComboBox Name="FilterByRoleCmb" Grid.Column="6"/>
            <Button Name="StartFiltersSearchBtn" Grid.Column="8" 
                    Content="Найти" Click="StartFiltersSearchBtn_Click"/>
        </Grid>

        <!-- Список, форма добавления/редактрирования -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width=".4*"/>
            </Grid.ColumnDefinitions>

            <ListView Name="UsersLv">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ФИО" 
                                        DisplayMemberBinding="{Binding Employee.FullName}"/>
                        <GridViewColumn Header="Логин" 
                                        DisplayMemberBinding="{Binding Login}"/>
                        <GridViewColumn Header="Роль" 
                                        DisplayMemberBinding="{Binding Role.Name}"/>
                        <GridViewColumn Header="Статус блокировки" 
                                        DisplayMemberBinding="{Binding Employee.IsActive}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
