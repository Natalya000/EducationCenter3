<Window x:Class="EducationCenter3.View.Windows.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EducationCenter3.View.Windows"
        mc:Ignorable="d"
                Title="Окно авторизации" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition Height="20"/>
            <RowDefinition/>
            <RowDefinition Height="20"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Логин"/>
        <TextBox Name="LoginTb" Grid.Column="2"/>
        <TextBlock Text="Пароль" Grid.Row="2"/>
        <PasswordBox Name="PasswordPb" Grid.Row="2" Grid.Column="2"/>
        <CheckBox Name="IsRememberCb" Grid.Row="4" Grid.Column="2" Content="Запомнить меня"/>
        <Button Name="LoginBtn" Grid.Row="6" Grid.Column="2" Content="Войти" Click="LoginBtn_Click"/>
    </Grid>
</Window>